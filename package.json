    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ci": "PLAYWRIGHT_START_SERVER=1 playwright test",
    "test:e2e:full": "PLAYWRIGHT_FULL_MATRIX=1 playwright test",
    "test:e2e:full:ci": "PLAYWRIGHT_START_SERVER=1 PLAYWRIGHT_FULL_MATRIX=1 playwright test",
