# Husky pre-commit
# Runs lint-staged: eslint --fix + prettier on staged files only.
# Then ensures every edge function dir is pinned in config.toml (auto-fix +
# stage the change so committers never have to think about it).
# Bypass with `git commit --no-verify` if absolutely needed.
#
# Shell builtins only up to the exec — no Cygwin fork needed.
# This lets the hook survive Windows MSYS2 STATUS_DLL_INIT_FAILED fork failures.
#
# Merge commits: skip lint-staged entirely (files were linted in their source
# branch; the git-stash isolation lint-staged uses breaks under MERGE_HEAD).
# [ -f ... ] is a shell builtin — no fork. Route both paths through exec so
# node.exe (native Windows) handles all child-process spawning.
if [ -f ".git/MERGE_HEAD" ]; then
  exec node scripts/ci/run-pre-commit.mjs --merge
fi
exec node scripts/ci/run-pre-commit.mjs
